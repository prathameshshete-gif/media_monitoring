# Copy to .env and fill in. Never commit the real file.

# Required for the report step. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-pro-preview; gemini-2.5-pro is the stable
# fallback if a preview id is ever withdrawn.
# GEMINI_MODEL=gemini-3.1-pro-preview

# --- Deployment knobs, all optional -----------------------------------------
# Swap the cross-encoder on a memory-tight host. The gte model is 306M params
# against bge's 568M: roughly twice as fast, some Marathi ranking quality lost.
# RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
# RERANKER_BATCH_SIZE=4

# Host port nginx proxies to. 8000 is already taken on the shared EC2 box.
# APP_PORT=8010
